{
  "name": "logseq-callout",
  "description": "Tag-driven callout styling for Logseq blocks — icons, labels, colored backgrounds with nested visual hierarchy",
  "version": "1.0.0",
  "author": "Danzu",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/hdansou/Logseq-callout#readme",
  "bugs": {
    "url": "https://github.com/hdansou/Logseq-callout/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hdansou/Logseq-callout.git"
  },
  "keywords": [
    "logseq",
    "logseq-plugin",
    "logseq-db",
    "callout",
    "admonition"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "scripts/e2e/callouts-matrix.sh"
  },
  "dependencies": {
    "@logseq/libs": "^0.3.4"
  },
  "devDependencies": {
    "@tabler/icons-webfont": "2.47.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.17",
      "lodash-es": "^4.18.1",
      "postcss": "^8.5.30",
      "nanoid": "^3.3.20",
      "esbuild": "^0.28.2",
      "source-map-js": "^1.2.2"
    }
  },
  "logseq": {
    "id": "logseq-danzu-callout",
    "title": "Callout Manager",
    "description": "Tag-driven callout styling — icons, labels, colored backgrounds with nested visual hierarchy",
    "icon": "./icon.svg",
    "main": "dist/index.html",
    "minSDKVersion": "0.3.4",
    "web": true,
    "effect": true,
    "supportsDB": true,
    "supportsDBOnly": true
  }
}
